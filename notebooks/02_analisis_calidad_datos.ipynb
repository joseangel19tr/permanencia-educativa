import pandas as pd
import numpy as np

# 1. Cargar las 3 fuentes
df_sep = pd.read_excel('../data/raw/sep/serie_historica_entidades_sep.xlsm', engine='openpyxl')
df_inegi = pd.read_excel('../data/raw/inegi/Educacion_abandono.xlsx', header=2)
# Ajusta el nombre del archivo de CONEVAL según lo que descargaste
df_coneval = pd.read_excel('../data/raw/coneval/anexo_estadistico_coneval.xlsx') 

print("✅ Datos cargados correctamente")

# 2. Dimensión: COMPLETITUD (Valores Nulos)
print("\n--- 1. COMPLETITUD ---")
print("SEP - Nulos:", df_sep.isnull().sum().sum())
print("INEGI - Nulos:", df_inegi.isnull().sum().sum())
print("CONEVAL - Nulos:", df_coneval.isnull().sum().sum())

# 3. Dimensión: UNICIDAD (Duplicados)
print("\n--- 2. UNICIDAD ---")
print("SEP - Duplicados:", df_sep.duplicated().sum())
print("INEGI - Duplicados:", df_inegi.duplicated().sum())
print("CONEVAL - Duplicados:", df_coneval.duplicated().sum())

# 4. Dimensión: CONSISTENCIA (¡MUY IMPORTANTE PARA BI!)
# Revisar si los nombres de los estados son iguales en las 3 fuentes
print("\n--- 3. CONSISTENCIA (Nombres de Entidades) ---")
# Ajusta el nombre de la columna de estado según tus archivos reales
col_estado_sep = df_sep.columns[0] # Ejemplo
col_estado_inegi = df_inegi.columns[0] # Ejemplo
col_estado_coneval = df_coneval.columns[0] # Ejemplo

estados_sep = set(df_sep[col_estado_sep].dropna().unique())
estados_inegi = set(df_inegi[col_estado_inegi].dropna().unique())

print(f"Estados en SEP: {len(estados_sep)}")
print(f"Estados en INEGI: {len(estados_inegi)}")
print(f"Diferencias: {estados_sep.symmetric_difference(estados_inegi)}")

# 5. Dimensión: VALIDEZ (Reglas de negocio)
print("\n--- 4. VALIDEZ ---")
