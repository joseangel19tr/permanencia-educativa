import pyreadstat
import pandas as pd

# Ruta al archivo DTA de CONEVAL
ruta_dta = '../data/coneval/Pobreza_municipal_2020_VCORTA/MunEBPH_2020/datos/entradas/06_bases_pobreza/pobreza_20.dta'

# Leer el archivo DTA
print("Leyendo archivo DTA de CONEVAL...")
df_coneval, meta = pyreadstat.read_dta(ruta_dta)

print(f"✅ Archivo cargado: {df_coneval.shape[0]} filas, {df_coneval.shape[1]} columnas")
print(f"\n📋 Primeras columnas:")
print(df_coneval.columns[:20].tolist())

# Guardar como CSV (más fácil de trabajar)
ruta_csv = '../data/raw/coneval/pobreza_municipal_2020.csv'
df_coneval.to_csv(ruta_csv, index=False, encoding='utf-8')
print(f"\n✅ CSV guardado en: {ruta_csv}")

# Ver primeras filas
print("\n📄 Primeras 5 filas:")
print(df_coneval.head())