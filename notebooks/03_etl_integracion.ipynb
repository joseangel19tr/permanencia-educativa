import pandas as pd
import numpy as np

print("INICIANDO PROCESO ETL...")

# 1. EXTRACCIÓN Y LIMPIEZA INICIAL
# SEP: Saltamos las filas basura iniciales (header=3)
df_sep = pd.read_excel('../data/raw/sep/serie_historica_entidades_sep.xlsm', engine='openpyxl', header=3)
df_sep.columns = df_sep.columns.str.strip()
df_sep = df_sep.dropna(how='all') # Elimina filas totalmente vacías

# INEGI: Saltamos filas basura (header=5) y eliminamos duplicados detectados en Sprint 2
df_inegi = pd.read_excel('../data/raw/inegi/Educacion_abandono.xlsx', header=5)
df_inegi.columns = df_inegi.columns.str.strip()
df_inegi = df_inegi.drop_duplicates() # Elimina los 6 duplicados detectados
df_inegi = df_inegi[~df_inegi['Entidad federativa'].str.contains('Estados Unidos Mexicanos|notas:', na=False)]

# CONEVAL: Carga directa (los nulos masivos son esperados en indicadores específicos, no los tocamos aún)
df_coneval = pd.read_csv('../data/raw/coneval/pobreza_municipal_2020.csv', encoding='utf-8')

print(f"Datos limpios: SEP ({df_sep.shape}), INEGI ({df_inegi.shape}), CONEVAL ({df_coneval.shape})")

# 2. TRANSFORMACIÓN (Estandarización de nombres de entidades para poder unirlos)
# Creamos un diccionario de mapeo para unificar nombres (ej. "Ciudad de México" vs "CDMX")
mapeo_entidades = {
    'CDMX': 'Ciudad de México',
    'DISTRITO FEDERAL': 'Ciudad de México',
    'MEXICO': 'Estado de México',
    'MICHOACAN': 'Michoacán',
    'YUCATAN': 'Yucatán'
    # (Se puede expandir según las diferencias exactas detectadas)
}

# Aplicar mapeo y limpiar espacios
df_inegi['Entidad federativa'] = df_inegi['Entidad federativa'].str.upper().replace(mapeo_entidades).str.title()
# (Aplicar lógica similar a df_sep y df_coneval según sus nombres de columna)

# 3. CARGA (Generación del Dataset Analítico)
# Para este sprint, guardamos las tablas limpias por separado o una unida a nivel Entidad
# Ejemplo simplificado de unión a nivel Entidad para el modelo dimensional:
df_analitico = pd.merge(df_inegi, df_coneval[['ent', 'nom_ent', 'pp_pobre']], 
                        left_on='Entidad federativa', right_on='nom_ent', how='left')

# Guardar resultado
df_analitico.to_csv('../data/processed/dataset_analitico_v1.csv', index=False, encoding='utf-8')
print("ETL completado. Dataset analítico guardado en /data/processed/")